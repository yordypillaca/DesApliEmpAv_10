@model IEnumerable<Reserva>
@{
    ViewData["Title"] = "Reservas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Reservas</h1>
    <a class="btn btn-primary" asp-action="Create">Nueva reserva</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Huésped</th>
            <th>Habitación</th>
            <th>Ingreso</th>
            <th>Salida</th>
            <th>Estado</th>
            <th class="text-end">Total</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            var noches = r.FechaSalida.DayNumber - r.FechaIngreso.DayNumber;
            var total = noches * r.IdHabitacionNavigation.IdTipoHabitacionNavigation.PrecioNoche;
            var clase = r.Estado switch
            {
                "Confirmada" => "text-bg-success",
                "Pendiente" => "text-bg-warning",
                "Cancelada" => "text-bg-secondary",
                _ => "text-bg-info"
            };
            <tr>
                <td>@r.IdHuespedNavigation.Nombres @r.IdHuespedNavigation.Apellidos</td>
                <td>@r.IdHabitacionNavigation.Numero</td>
                <td>@r.FechaIngreso.ToString("d")</td>
                <td>@r.FechaSalida.ToString("d")</td>
                <td><span class="badge @clase">@r.Estado</span></td>
                <td class="text-end">@total.ToString("C")</td>
                <td class="text-end">
                    @if (r.Estado == "Pendiente" || r.Estado == "Confirmada")
                    {
                        <form asp-action="Cancelar" asp-route-id="@r.IdReserva" method="post" class="d-inline">
                            <button class="btn btn-sm btn-outline-danger">Cancelar</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">No hay reservas.</p>
}
