@{
    ViewData["Title"] = "Inicio";
}

<h1 class="mb-4">Hotel</h1>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="fs-2 fw-semibold">@ViewBag.Habitaciones</div>
                <div class="text-muted mb-3">Habitaciones activas</div>
                <a class="btn btn-primary" asp-controller="Habitaciones" asp-action="Index">Habitaciones</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="fs-2 fw-semibold">@ViewBag.Reservas</div>
                <div class="text-muted mb-3">Reservas</div>
                <a class="btn btn-primary" asp-controller="Reservas" asp-action="Index">Reservas</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <div class="text-muted mb-3">Consulta habitaciones libres por fechas</div>
                <a class="btn btn-outline-primary mt-auto" asp-controller="Reservas" asp-action="Disponibles">Disponibilidad</a>
            </div>
        </div>
    </div>
</div>
